# Copy this file to .env and fill in real values. .env is ignored by git; this file is committed.
# Real environment variables override values in .env.

# Required. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-long-random-string

# Optional (default False). Use True for local development only.
DEBUG=True

# Optional, comma-separated (default localhost,127.0.0.1).
ALLOWED_HOSTS=localhost,127.0.0.1
